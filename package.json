{
  "name": "fii-prism",
  "version": "0.1.0",
  "private": true,
  "description": "FII-PRISM — Factor Impact Intelligence v2 (web). Anthropic + AWS only.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev:web": "pnpm --filter @fii/web dev",
    "build:web": "pnpm --filter @fii/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "cdk:synth": "pnpm --filter @fii/infra synth",
    "cdk:diff": "pnpm --filter @fii/infra diff",
    "deploy:dev": "pnpm --filter @fii/infra deploy:dev"
  },
  "devDependencies": {
    "prettier": "3.4.2",
    "typescript": "5.7.3"
  }
}
