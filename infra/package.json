    "constructs": "10.4.2",
    "source-map-support": "0.5.21"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "aws-cdk": "2.175.1",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  }
}
