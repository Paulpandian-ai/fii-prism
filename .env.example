# FII-PRISM environment variables (copy to .env.local for local dev; production secrets live in AWS Secrets Manager)

# --- Core ---
NODE_ENV=development
LOG_LEVEL=info

# --- Local Postgres (docker-compose) ---
POSTGRES_USER=fii
POSTGRES_PASSWORD=fii_local_dev
POSTGRES_DB=fii_prism
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://fii:fii_local_dev@localhost:5432/fii_prism

# --- Next.js (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development

# --- Anthropic (dev) — production uses Bedrock via IAM role, not this key ---
ANTHROPIC_API_KEY=

# --- Data providers (added in later sections; listed here for visibility) ---
POLYGON_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=

# --- AWS (only needed for cdk deploy from a dev machine) ---
AWS_REGION=us-east-1
AWS_PROFILE=fii-dev
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=us-east-1
